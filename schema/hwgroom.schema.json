{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Groom Studio edits (hwgroom)",
 "type": "object",
 "required": ["format", "version", "character", "ops"],
 "additionalProperties": false,
 "properties": {
  "format": {"const": "hwgroom"},
  "version": {"const": 1},
  "character": {"type": "string"},
  "tol": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.05},
  "params": {"type": "object", "description": "look / material overrides, parameter path -> number, bool, string, list of numbers (max 16) or colour / vector object (R,G,B,A or X,Y,Z,W)", "additionalProperties": {"oneOf": [{"type": ["number", "boolean", "string"]}, {"type": "array", "maxItems": 16, "items": {"type": "number"}}, {"type": "object", "maxProperties": 4, "additionalProperties": {"type": "number"}}]}},
  "ops": {"type": "array", "maxItems": 20000, "items": {"$ref": "#/$defs/op"}},
  "material": {"type": "string", "pattern": "^[A-Za-z0-9 _().,+'-]{1,96}$", "description": "Studio material preset name (its values are already in params; restores the selection)"},
  "stiffness": {"type": "object", "additionalProperties": false, "required": ["guides", "s", "r"], "description": "painted per-guide stiffness (s) / root-stiffness (r) multipliers, index = guide index after the ops; applied only when the groom has 'guides' guides",
   "properties": {"guides": {"type": "integer", "minimum": 1, "maximum": 100000},
    "s": {"type": "array", "maxItems": 100000, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "r": {"type": "array", "maxItems": 100000, "items": {"type": "number", "minimum": 0, "maximum": 1}}}},
  "colliders": {"type": "object", "additionalProperties": false, "required": ["spheres", "capsules"], "description": "the project's collision set; replaces the fur's own spheres / capsules. Bones by name, local = offset in the bone frame (m)",
   "properties": {
    "spheres": {"type": "array", "maxItems": 85, "items": {"type": "object", "required": ["bone", "local", "r"],
     "properties": {"bone": {"type": "string", "pattern": "^[A-Za-z0-9_]{1,40}$"}, "local": {"$ref": "#/$defs/vec3"}, "r": {"type": "number", "minimum": 0.0005, "maximum": 0.25},
      "grp": {"type": "integer", "minimum": -1, "maximum": 2}, "tag": {"type": "string", "maxLength": 40}}}},
    "capsules": {"type": "array", "maxItems": 75, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}}},
    "collision_r": {"type": "object", "description": "sphere index -> collision radius override (m)", "propertyNames": {"pattern": "^[0-9]{1,3}$"}, "additionalProperties": {"type": "number", "minimum": 0.0005, "maximum": 0.25}},
    "flats": {"type": "object", "maxProperties": 85, "description": "flat colliders (panels of thin capsules): id -> parameters", "propertyNames": {"pattern": "^[0-9]{1,6}$"},
     "additionalProperties": {"type": "object", "required": ["bone", "c"], "properties": {"bone": {"type": "string", "pattern": "^[A-Za-z0-9_]{1,40}$"}, "c": {"$ref": "#/$defs/vec3"}}}}}}
 },
 "$defs": {
  "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
  "roots": {"type": "array", "items": {"$ref": "#/$defs/vec3"}, "minItems": 1},
  "op": {
   "type": "object",
   "oneOf": [
    {"properties": {"type": {"const": "translate"}, "roots": {"$ref": "#/$defs/roots"}, "offset": {"$ref": "#/$defs/vec3"},
      "falloff": {"enum": ["carry", "linear", "tip", "point"]}, "from": {"type": "integer", "minimum": 0}},
     "required": ["type", "roots", "offset"]},
    {"properties": {"type": {"const": "set_point"}, "root": {"$ref": "#/$defs/vec3"}, "index": {"type": "integer", "minimum": 0},
      "pos": {"$ref": "#/$defs/vec3"}, "carry": {"type": "boolean"}},
     "required": ["type", "root", "index", "pos"]},
    {"properties": {"type": {"const": "shorten"}, "roots": {"$ref": "#/$defs/roots"}, "keep": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}},
     "required": ["type", "roots", "keep"]},
    {"properties": {"type": {"const": "delete"}, "roots": {"$ref": "#/$defs/roots"}}, "required": ["type", "roots"]},
    {"properties": {"op": {"const": "duplicate"}, "type": {"const": "duplicate"}, "root": {"$ref": "#/$defs/vec3"}, "d": {"$ref": "#/$defs/vec3"}, "id": {"type": "integer"}},
     "required": ["root", "d"], "anyOf": [{"required": ["op"]}, {"required": ["type"]}]},
    {"properties": {"type": {"const": "reshape"}, "root": {"$ref": "#/$defs/vec3"}, "points": {"type": "array", "items": {"$ref": "#/$defs/vec3"}, "minItems": 2}},
     "required": ["type", "root", "points"]},
    {"properties": {"type": {"const": "mirror"}, "source": {"enum": ["+x", "-x"]}, "plane_x": {"type": ["number", "string"]}, "source_roots": {"type": "array", "items": {"$ref": "#/$defs/vec3"}, "description": "resolved at export: roots of the guides mirrored from the source side"}, "band": {"type": "number"},
      "ymin": {"type": "number"}, "ymax": {"type": "number"}, "zmin": {"type": "number"}, "zmax": {"type": "number"},
      "conform": {"type": "number"}, "lateral": {"type": "object"}, "ear_shift": {"type": "object"}},
     "required": ["type", "source"]},
    {"properties": {"type": {"const": "delete_face"}, "roots": {"type": "array", "items": {"$ref": "#/$defs/vec3"}, "minItems": 3, "maxItems": 3},
      "face": {"type": "integer", "minimum": -1, "description": "index into the base mesh faces (checked against pack.json mesh_fingerprint); -1 = a face made by earlier ops, found by roots"}},
     "required": ["type", "roots", "face"]},
    {"properties": {"type": {"const": "rebuild"}, "kind": {"enum": ["from_cards", "baked"], "description": "from_cards = parametric (the Studio replays its own algorithm); baked = geometry snapshot in params: guides [[x,y,z]*K], uv [[u,v]], faces [[i,j,k]], face_uv [[u0,v0,u1,v1,u2,v2]]; replaces every guide of the loaded groom"}, "params": {"type": "object"}, "studio_version": {"type": "string"}},
     "required": ["type", "kind", "params", "studio_version"], "additionalProperties": false}
   ]
  }
 }
}
